# dev | prod. dev = local defaults + auto-created bucket; prod = everything explicit.
ENV=dev

# --- S3-compatible storage (dev: RustFS from docker compose; prod: B2, R2, AWS S3, ...)
# Leave S3_ENDPOINT_URL empty for AWS S3.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_BUCKET=nyc-taxi

# --- Warehouse (DuckDB). A file path, or md:<database> for MotherDuck.
WAREHOUSE_DATABASE=./data/nyc_taxi.duckdb
WAREHOUSE_SCHEMA=nyc_taxi
# Only needed when WAREHOUSE_DATABASE starts with md:
# MOTHERDUCK_TOKEN=

# --- Source (optional override)
# TLC_BASE_URL=https://d37ci6vzurychx.cloudfront.net/trip-data
